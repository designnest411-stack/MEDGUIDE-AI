rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User-isolated multi-tenant security model:
    // Each authenticated clinician has full read/write access ONLY to their own sub-collections
    // (patients, consultations, timeline, imaging, reports, settings).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
